.DS_Store
.env

# Bun / TypeScript
node_modules/
dist/

# Python (MCP server)
/venv/
/.venv/
/build/
*.spec
__pycache__/
*.pyc

# Course materials the Python MCP server downloads into its working directory (any folder)
*.pdf
*.ppt
*.pptx
*.doc
*.docx
*.xlsx
*.csv
*.html
*.xml
*.json
# ...but never our own source files
!package.json
!tsconfig.json
!/extension/**
!/site/*.html
!/.github/**

# Generated by `bun run --cwd tui site` (the Pages workflow regenerates them)
/site/demo.json
/site/assets/

# Brainstorming companion mockups
.superpowers/

# Extension screenshot/preview harness pages
/extension/.screenshot.html
/extension/.preview.html

# TUI preview renders (bun run --cwd tui preview)
tui/preview/
