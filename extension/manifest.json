{
  "manifest_version": 3,
  "name": "MyDY Moodle Downloader",
  "version": "1.0.1",
  "description": "Download course materials from MyDY Moodle portal",
  "permissions": [
    "activeTab",
    "downloads",
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "https://mydy.dypatil.edu/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MyDY Moodle Downloader",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mydy.dypatil.edu/*"
      ],
      "js": [
        "js/content.js"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
