{
  "manifest_version": 3,
  "name": "MyDy Extension",
  "version": "1.1.0",
  "description": "Download your MyDy course files in one go, sorted into a folder per course. Part of MyDy LMS Helper.",
  "permissions": [
    "activeTab",
    "downloads",
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "https://mydy.dypatil.edu/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "MyDy Extension",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mydy.dypatil.edu/*"
      ],
      "js": [
        "js/content.js"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}